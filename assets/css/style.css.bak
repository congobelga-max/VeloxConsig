body{
    background:#f4f5f7;
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    padding-bottom:30px;
}

header{

	background:#000000;
    padding:20px 15px;

    text-align:center;

    border-bottom:2px solid #ff6b00;

    box-shadow:0 3px 12px rgba(0,0,0,.45);

}
header img{

    width:180px;

    max-width:90%;

    height:auto;

    display:block;

    margin:auto;

}
.container-fluid{
    padding:15px;
}

.dashboard{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
    margin-bottom:20px;
}

.cardDash{
    background:white;
    border-radius:15px;
    padding:15px;
    text-align:center;
    box-shadow:0 2px 8px rgba(0,0,0,.08);
}

.cardDash h2{
    margin:0;
    font-size:26px;
    color:#ff6b00;
}

.cardDash span{
    font-size:13px;
    color:#666;
}

.importar{

    display:flex;

    gap:10px;

    margin-bottom:20px;

}

.btnImportar,
.btnExportar{

    flex:1;

    height:55px;

    border:none;

    border-radius:14px;

    color:white;

    font-weight:bold;

    font-size:16px;

}

.btnImportar{

    background:#ff6b00;

}

.btnExportar{

    background:#0F172A;

}

#arquivo{
    position:absolute;
    left:-9999px;
    width:1px;
    height:1px;
    opacity:0;
}
#clientes{
    display:flex;
    flex-direction:column;
    gap:15px;
}

.cliente{

    background:white;
    border-radius:18px;
    padding:18px;

    box-shadow:0 2px 10px rgba(0,0,0,.08);

}

.topo{

    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;

}

.nome{

    font-size:18px;
    font-weight:bold;
    color:#222;

}

.status{

    width:15px;
    height:15px;
    border-radius:50%;

}

.nao{

    background:#bbb;

}

.com{

    background:#20c55e;

}

.sem{

    background:#facc15;

}

.rotulo{

    font-size:11px;
    color:#888;
    text-transform:uppercase;
    margin-bottom:3px;

}

.valor{

    font-size:17px;
    color:#111;
    margin-bottom:12px;

}

.acoes{

    display:flex;
    justify-content:space-between;
    margin-top:12px;

}

.btnZap{

    width:82%;
    border:none;
    height:48px;
    border-radius:12px;
	background:#25D366;    
	color:white;
    font-size:16px;
    font-weight:bold;

}
.menu{

    width:48px;
    border:none;
    border-radius:12px;
    background:#ececec;
    font-size:22px;

}

.dropdown-menu{

    border-radius:12px;

}

.dropdown-item{

    font-size:15px;
    padding:12px;

}

footer{

    text-align:center;
    color:#777;
    margin-top:20px;
    font-size:12px;

}

.destacado{

    border:3px solid #ff6b00;

    transform:scale(1.02);

    transition:.35s;

    box-shadow:0 0 18px rgba(255,107,0,.35);

}

.cardDash{

    cursor:pointer;

    transition:.25s;

}

.cardDash.ativo{

    background:#ff6b00;

    color:white;

}

.cardDash.ativo h2{

    color:white;

}

.cardDash.ativo span{

    color:white;

}

.pesquisa{

    display:flex;
    align-items:center;
    background:white;
    border:1px solid #ddd;
    border-radius:14px;
    padding:0 14px;
    height:52px;
    margin-bottom:20px;
    box-shadow:0 2px 8px rgba(0,0,0,.05);

}

.pesquisa > i{

    font-size:18px;
    color:#777;
    margin-right:10px;

}

.pesquisa input{

    flex:1;
    border:none;
    outline:none;
    background:transparent;
    font-size:16px;
    min-width:0;

}

.pesquisa input::placeholder{

    color:#999;

}

#limparPesquisa{

    display:none;
    border:none;
    background:transparent;
    color:#777;
    font-size:17px;
    padding:8px;

}

.valorCopiavel{
    color:#ff0000 !important;
    font-weight:bold;
}
.btnProposta{width:100%;border:none;height:46px;border-radius:12px;background:#111;color:#fff;font-size:15px;font-weight:bold}
.modalPropostaConteudo{border:none;border-radius:18px;overflow:hidden}
.clienteProposta{background:#f5f5f5;border-radius:12px;padding:10px 12px;margin-bottom:14px;font-weight:bold}
.campoProposta{border-radius:12px;font-size:14px}
.btnGerarProposta{width:100%;border:none;border-radius:12px;min-height:48px;margin-top:12px;background:#ff6b00;color:#fff;font-weight:bold;font-size:16px}
.avisoProposta{display:none;margin-top:12px;padding:10px 12px;border-radius:10px;background:#fff3cd;color:#664d03;font-size:13px;font-weight:600}
.modalPropostaAcoes{display:grid;grid-template-columns:1fr 1.4fr;gap:8px}
.btnCopiarProposta,.btnEnviarProposta{border:none;border-radius:12px;min-height:48px;font-weight:bold}
.btnCopiarProposta{background:#e9ecef;color:#222}.btnEnviarProposta{background:#25D366;color:#fff}
